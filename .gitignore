# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── 虚拟环境 ─────────────────────────────────────────────
venv/
.venv/
env/

# ── 数据库（本地数据，不上传）────────────────────────────
data/db/*.db
data/db/*.db-shm
data/db/*.db-wal

# ── 素材文件（图片/视频太大，不上传）────────────────────
materials/output/
materials/raw/
data/raw/

# ── 日志 ─────────────────────────────────────────────────
*.log
logs/

# ── 环境配置（含密钥，绝对不上传）──────────────────────
.env
.env.*
config/secrets.yaml
config/secrets.yml

# ── macOS ─────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE ───────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── 临时文件 ─────────────────────────────────────────────
*.tmp
*.bak
*.orig

# ── 本地配置（含API密钥）────────────────────────────────
config/config.local.yaml
config/secrets*.yaml

# ── 数据库（含真实业务数据）──────────────────────────────
data/main.db
data/main.db-*
